---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Check your inbox" description="Confirm your subscription." noindex>
  <section class="section">
    <div class="narrow">
      <h1>Almost done. Check your inbox.</h1>
      <p class="lead">I've sent you an email to confirm your subscription. Once you confirm, the Accomplishment-to-Interview Story Worksheet will arrive.</p>
      <p>Can't find it? Check your spam or promotions folder. You can unsubscribe from any email with one click.</p>
      <p><a class="btn btn-secondary" href="/resources/worksheet/">Open the worksheet now</a></p>
    </div>
  </section>
</BaseLayout>
