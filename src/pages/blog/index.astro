---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getPosts, slugify, showDrafts } from '../../lib/utils';

const posts = await getPosts();
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
---

<BaseLayout
  title="Blog: Practical Career Advice for Product & Tech Professionals"
  description="Practical articles on resumes, interview stories, annual reviews, promotions, and product careers from product leader Yatin Choubal."
>
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Practical career notes</h1>
      <p class="lead">Resumes, interviews, reviews, and leadership moves for product and technology professionals. No fluff, and no invented success stories.</p>
      {showDrafts && posts.some((p) => p.data.draft) && (
        <p class="notice notice--warn small">Draft preview: posts marked Draft appear here in development only and are excluded from the live site until you publish them.</p>
      )}
    </div>
  </section>

  <section class="section--tight">
    <div class="container blog-grid">
      <div>
        {posts.length > 0 ? (
          <>
            <div class="tools" role="search">
              <div class="field">
                <label for="post-search">Search articles</label>
                <input type="search" id="post-search" placeholder="e.g. STAR stories, promotion, resume" />
              </div>
              <div class="field">
                <label for="post-cat">Category</label>
                <select id="post-cat">
                  <option value="">All categories</option>
                  {categories.map((c) => <option value={slugify(c)}>{c}</option>)}
                </select>
              </div>
            </div>
            <p id="results" class="small muted" aria-live="polite"></p>
            <PostList posts={posts} />
          </>
        ) : (
          <div class="card">
            <h2>New articles are on the way</h2>
            <p>The first practical guides are being written. Join the email list to get them as they're published.</p>
          </div>
        )}
      </div>
      <aside>
        <h2 class="h3">Categories</h2>
        <ul class="cats">
          {categories.map((c) => <li><a href={`/blog/category/${slugify(c)}/`}>{c}</a></li>)}
        </ul>
        <NewsletterForm />
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('post-search') as HTMLInputElement | null;
  const cat = document.getElementById('post-cat') as HTMLSelectElement | null;
  const results = document.getElementById('results');
  const items = [...document.querySelectorAll<HTMLElement>('.post-item')];
  const params = new URLSearchParams(location.search);
  if (input && params.get('q')) input.value = params.get('q')!;
  const apply = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    const c = cat?.value ?? '';
    let shown = 0;
    items.forEach((item) => {
      const match = (!q || q.split(/\s+/).every((w) => item.dataset.search!.includes(w))) && (!c || item.dataset.category === c);
      item.hidden = !match;
      if (match) shown++;
    });
    if (results) results.textContent = q || c ? `${shown} article${shown === 1 ? '' : 's'} found.` : '';
  };
  input?.addEventListener('input', apply);
  cat?.addEventListener('change', apply);
  apply();
</script>

<style>
  .blog-grid { display: grid; gap: 2.5rem; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr; } }
  .tools { display: grid; gap: 1rem; grid-template-columns: 2fr 1fr; margin-bottom: 0.75rem; }
  @media (max-width: 560px) { .tools { grid-template-columns: 1fr; } }
  .h3 { font-size: 1.2rem; }
  .cats { list-style: none; padding: 0; margin: 0 0 2rem; }
</style>
