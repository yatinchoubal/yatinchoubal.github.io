---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import FaqList from '../components/FaqList.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import home from '../data/home.json';
import faqs from '../data/faqs.json';
import site from '../data/site.json';
import { getServices, absoluteUrl } from '../lib/utils';

const services = await getServices();
const byPath = (id: string) => services.filter((s) => s.data.path === id);
const homeFaqs = faqs.items.filter((f) => f.showOnHome);
const pathLabels = ['Light touch', 'Focused', 'In depth'];

// Simple line icons for the audience tiles, in the same order as home.audience.
const icons = [
  '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  '<path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>',
  '<circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36z"/>',
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.brand} | ${site.brandSuffix}`,
    url: absoluteUrl('/'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: `${site.brand} | ${site.brandSuffix}`,
    url: absoluteUrl('/'),
    description: home.seoDescription,
    areaServed: 'Remote',
    founder: { '@type': 'Person', name: site.ownerName, url: absoluteUrl('/about/') },
    priceRange: '$49–$1,799',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout title={home.seoTitle} description={home.seoDescription} rawTitle jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{home.eyebrow}</p>
        <h1>{home.headline} <span class="serif">{home.headlineAccent}</span></h1>
        <p class="lead">{home.subheadline}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={home.primaryCta.href} data-event="Fit Call Click" data-event-label="Hero">{home.primaryCta.label}</a>
          <a class="btn btn-secondary" href={home.secondaryCta.href} data-event="CTA Click" data-event-label="Hero explore">{home.secondaryCta.label}</a>
        </div>
      </div>
      <ProfilePhoto priority chips={home.photoChips} />
    </div>
  </section>

  <section class="creds" aria-label="Background at a glance">
    <ul class="container creds-grid">
      {home.credentials.map((c) => (
        <li><strong>{c.title}</strong>{c.text}</li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="audience-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Who I work with</p>
        <h2 id="audience-heading">{home.audienceHeading} <span class="serif">{home.audienceHeadingAccent}</span></h2>
      </div>
      <div class="grid grid-4">
        {home.audience.map((a, i) => (
          <div class={`tile tile--${(i % 4) + 1}`}>
            <svg class="tile-icon" aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i % icons.length]} />
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--flush" aria-labelledby="paths-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">How I can help</p>
        <h2 id="paths-heading">{home.pathsHeading}</h2>
        <p>Every service includes the free Career Toolkit.</p>
      </div>
      <div class="grid grid-3">
        {home.paths.map((p, i) => (
          <a class="card path" href={`/services/#path-${p.id}`}>
            <span class="path-level">{pathLabels[i]}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
            <ul class="path-svcs">
              {byPath(p.id).map((s) => <li>{s.data.title}</li>)}
            </ul>
            <span class="path-more">Learn more <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--flush" aria-label={home.quoteCaption}>
    <div class="container">
      <figure class="quote">
        <blockquote>{home.quote} <span class="serif">{home.quoteAccent}</span></blockquote>
        <figcaption>{home.quoteCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--flush" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">{home.processHeading}</h2>
      </div>
      <ol class="steps grid grid-4">
        {home.process.map((step, i) => (
          <li class="step">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="background-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Background</p>
        <h2 id="background-heading">{home.backgroundHeading}</h2>
        <p class="muted">{home.backgroundText}</p>
        <a class="btn btn-secondary" href={home.backgroundCta.href}>{home.backgroundCta.label}</a>
      </div>
      <div class="expect">
        <h3>{home.honestyHeading}</h3>
        <ul class="check-list">
          {home.honestyPoints.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section section--alt" aria-labelledby="faq-heading">
    <div class="container two-col">
      <div>
        <h2 id="faq-heading">Common questions</h2>
        <p class="muted">Something else? <a href="/contact/">Send me a message</a>.</p>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .hero-grid { display: grid; gap: 3rem; align-items: center; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
  .hero h1 { max-width: 15ch; }
  .hero .lead { margin: 1.25rem 0 2rem; max-width: 32rem; }
  .hero :global(.photo) { justify-self: center; width: 100%; }
  @media (max-width: 800px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero :global(.photo) { justify-self: start; max-width: 16rem; }
  }

  .creds-grid { list-style: none; padding: 0; margin-block: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .creds-grid li { margin: 0; background: var(--warm-2); border-radius: 18px; padding: 1.2rem 1.4rem; color: var(--muted); font-size: 0.95rem; }
  .creds-grid strong { display: block; color: var(--ink); font-size: 1.25rem; font-weight: 800; letter-spacing: -0.02em; }

  .section--flush { padding-top: 0; }

  .tile { border-radius: var(--radius); padding: 1.6rem; }
  @media (min-width: 801px) { .tile { min-height: 11rem; } }
  .tile--1 { background: var(--lav); }
  .tile--2 { background: var(--mint); }
  .tile--3 { background: var(--peach); }
  .tile--4 { background: var(--sky); }
  .tile-icon { color: var(--ink); margin-bottom: 1rem; }
  .tile h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
  .tile p { margin: 0; color: #3e404a; font-size: 0.97rem; }

  .path { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); transition: border-color 0.2s, transform 0.2s; }
  .path:hover { border-color: var(--lav-2); transform: translateY(-3px); color: var(--ink); }
  .path-level { font-size: 0.8rem; font-weight: 700; color: var(--lav-ink); }
  .path h3 { font-size: 1.4rem; margin: 0.35rem 0 0.5rem; }
  .path-svcs { list-style: none; padding: 0; margin: 0.25rem 0 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; align-content: flex-start; flex: 1; }
  .path-svcs li { margin: 0; background: var(--warm-2); border-radius: 999px; padding: 0.35rem 0.85rem; font-size: 0.85rem; font-weight: 600; }
  .path-more { font-weight: 700; text-decoration: underline; text-underline-offset: 0.2em; }

  .quote { margin: 0; background: var(--ink); color: #fff; border-radius: 32px; padding: clamp(3rem, 7vw, 4.5rem) clamp(1.5rem, 5vw, 3rem); text-align: center; }
  .quote blockquote { margin: 0 auto; max-width: 46rem; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -0.02em; font-weight: 800; text-wrap: balance; }
  .quote .serif { color: #c9c0ff; }
  .quote figcaption { color: #a7a8b4; margin-top: 1.2rem; font-size: 0.95rem; }

  .steps { list-style: none; padding: 0; margin: 0; }
  .step { margin: 0; background: var(--warm-2); border-radius: var(--radius); padding: 1.6rem; }
  .step-num {
    display: inline-grid; place-items: center;
    width: 2.2rem; height: 2.2rem; border-radius: 50%;
    background: #fff; color: var(--ink); font-weight: 800; margin-bottom: 1rem;
    box-shadow: 0 2px 6px rgb(0 0 0 / 6%);
  }
  .step h3 { font-size: 1.1rem; margin-bottom: 0.35rem; }
  .step p { margin: 0; color: var(--muted); font-size: 0.97rem; }

  .two-col { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); align-items: start; }
  .expect { background: var(--mint); border-radius: var(--radius); padding: 1.75rem; }
  .expect ul { margin: 0; }
</style>
