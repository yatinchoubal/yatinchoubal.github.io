---
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import payments from '../data/payments.json';
import { absoluteUrl } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Use the full title as-is rather than appending the brand. */
  rawTitle?: boolean;
}

const {
  title,
  description = site.defaultDescription,
  image = site.socialImage,
  imageAlt = `${site.brand} | ${site.brandSuffix}`,
  type = 'website',
  noindex = false,
  jsonLd,
  rawTitle = false,
} = Astro.props;

const fullTitle = rawTitle ? title : `${title} | ${site.brand}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const robots = !site.indexing || noindex ? 'noindex, nofollow' : 'index, follow';
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const isTestMode = payments.mode !== 'live';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#17171c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.brand} blog`} href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.brand} | ${site.brandSuffix}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {site.searchConsoleVerification && (
      <meta name="google-site-verification" content={site.searchConsoleVerification} />
    )}
    {site.analytics.plausibleDomain && (
      <script is:inline defer data-domain={site.analytics.plausibleDomain} src={site.analytics.plausibleScriptUrl}></script>
      <script is:inline>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments); };</script>
    )}
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {isTestMode && (
      <div class="test-banner" role="note">
        Draft site in test mode. No live payments are taken.
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Privacy-conscious conversion events: fires only if Plausible is configured.
      document.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement).closest<HTMLElement>('[data-event]');
        const plausible = (window as any).plausible;
        if (target && typeof plausible === 'function') {
          plausible(target.dataset.event, { props: { label: target.dataset.eventLabel ?? '' } });
        }
      });
    </script>
  </body>
</html>

<style>
  .test-banner {
    background: var(--amber-tint);
    border-bottom: 1px solid var(--amber-line);
    color: #5c3f00;
    font-size: 0.85rem;
    text-align: center;
    padding: 0.35rem 1rem;
  }
  main:focus { outline: none; }
</style>
